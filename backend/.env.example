# Server
PORT=4000

# MongoDB (optional for local smoke tests without DB — leave empty to skip connect)
MONGODB_URI=mongodb://127.0.0.1:27017/nexaspark

# Auth (required when auth routes are enabled)
JWT_SECRET=change-me-in-development-use-long-random-string
JWT_EXPIRES_IN=7d

# Region defaults (MVP — see NexaSpark.md §3.3)
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
LOCALE=en-IN

# CORS: browser origin for the static frontend (adjust port if you use a different dev server)
CLIENT_ORIGIN=http://127.0.0.1:8080

# Stripe (optional — leave empty to use stub checkout only)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Mobile + Stripe (web success page): success/cancel URLs use CLIENT_ORIGIN unless the client sends
# checkoutReturn=app (see stripeCheckout route). On a physical device, CLIENT_ORIGIN must be reachable
# from the phone (e.g. http://192.168.1.10:8080), not http://127.0.0.1:8080.
#
# Mobile + Stripe (app deep link): when checkoutReturn=app, defaults are nexaspark://checkout/success?session_id={CHECKOUT_SESSION_ID}
# and nexaspark://checkout/cancel (must match expo app scheme + Linking.createURL('checkout/success')).
# Optional overrides (must include {CHECKOUT_SESSION_ID} in success):
# STRIPE_APP_SUCCESS_URL=nexaspark://checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_APP_CANCEL_URL=nexaspark://checkout/cancel

# Seed: optional admin account (npm run seed)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me

# Legal URLs for footer and production listings (placeholders until real pages exist)
PRIVACY_POLICY_URL=http://127.0.0.1:8080/privacy
TERMS_OF_SERVICE_URL=http://127.0.0.1:8080/terms

# Email (optional — order confirmation uses structured logs when SMTP_HOST is unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NexaSpark <noreply@example.com>"
